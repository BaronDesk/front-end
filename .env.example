# Copy to .env.local and adjust.

# Where the Vite dev server proxies API and socket calls.
# docker-compose.dev.yml exposes Nest directly on :3000.
VITE_BACKEND_URL=http://localhost:3000

# true = endpoints are answered in the browser with fake data (src/mocks).
# Seed accounts are listed in src/mocks/server.ts (password "password123").
VITE_USE_MOCKS=true

# With mocks on, send these prefixes to the real backend anyway.
# Empty = fully offline.
# Real backend (identity, /api/v1: stations, commands, alerts, games, and
# /machines: enrollment), with fake data only for what isn't linked yet
# (sessions, wallet, bookings…):
#   VITE_REAL_PREFIXES=/auth,/users,/employees,/api,/machines,/dashboard-io
VITE_REAL_PREFIXES=
