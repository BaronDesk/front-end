# Copy to .env.local and adjust.

# Where the Vite dev server sends API and socket calls: the backend on this
# PC (back-end/: npm run docker:dev exposes Nest on :3000).
VITE_BACKEND_URL=http://localhost:3000

# Only for a build served from another origin than the backend (not needed in
# dev or behind Caddy): the backend's origin, e.g. https://cstam-server.local
# VITE_API_BASE=
